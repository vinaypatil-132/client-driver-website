# Database connection (PostgreSQL in Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/licensed_installer_demo?schema=public"

# Backblaze B2 S3-Compatible Storage Configuration
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET_NAME="keyboard-driver-demo"
B2_KEY_ID="your_b2_key_id"
B2_APPLICATION_KEY="your_b2_application_key"

# App base URL (for local dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
